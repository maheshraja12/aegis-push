# Copy to .env for local configuration. Never commit real credentials.
AEGIS_ENV=development
AEGIS_DASHBOARD_USERNAME=
AEGIS_DASHBOARD_PASSWORD=
AEGIS_ALLOWED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001
AEGIS_ENABLE_PIPELINE_API=false
AEGIS_DB_PATH=./aegis_v3_audit.db
OPENAI_API_KEY=
LOG_LEVEL=INFO
LOG_FORMAT=plain
